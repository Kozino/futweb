# ---------------------------------------------------------------------------
# Edge function secrets — LOCAL DEVELOPMENT ONLY.
# Copy to `.env.local` in this folder for `supabase functions serve`.
# In production these are never in a file — set them with:
#   supabase secrets set KEY=value
# ---------------------------------------------------------------------------

# Auto-injected by the platform in production; set manually for local `serve`.
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Flutterwave — TEST mode keys from https://dashboard.flutterwave.com
FLW_SECRET_KEY=
# Must exactly match the "Secret Hash" set on the Flutterwave webhook config.
FLW_SECRET_HASH=

# Redirect target after checkout, and CORS allow-list. In production these
# must be the real frontend origin — never "*".
APP_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173
