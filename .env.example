# ---------------------------------------------------------------------------
# FutWeb environment
# Copy to `.env.local`. Never commit real values.
#
# If VITE_SUPABASE_URL is absent the app boots in Demo Mode: every screen is
# fully interactive against a local store, so designers and reviewers can work
# without production secrets.
# ---------------------------------------------------------------------------

# ---- Supabase (auth, Postgres, storage, edge functions) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Flutterwave ----
# Public key only. The SECRET key lives in edge function env, never here.
VITE_FLUTTERWAVE_PUBLIC_KEY=

# ---- App ----
VITE_APP_URL=http://localhost:5173

# ---- Edge function secrets (set with `supabase secrets set`, NOT in this file)
# SUPABASE_SERVICE_ROLE_KEY=
# FLW_SECRET_KEY=
# FLW_SECRET_HASH=        # must match "Secret Hash" in the Flutterwave dashboard
# ALLOWED_ORIGIN=         # e.g. https://futweb.app — locks down CORS
# APP_URL=                # redirect target after checkout
